<?php

/**
 * @file
 * Redis install related functions.
 */

use Drupal\Component\Utility\DeprecationHelper;
use Drupal\Core\Extension\Requirement\RequirementSeverity;
use Drupal\Core\Hook\Attribute\LegacyRequirementsHook;

/**
 * Implements hook_requirements().
 */
#[LegacyRequirementsHook]
function redis_requirements($phase) {

  // This module is configured via settings.php file. Using any other phase
  // than runtime to proceed to some consistency checks is useless.
  if ('runtime' !== $phase) {
    return [];
  }

  $requirements = [];

  $factory = \Drupal::service('redis.factory');

  if ($factory->hasClient()) {
    $requirements['redis'] = [
      'title'       => "Redis",
      'value'       => t("Connected, using the <em>@name</em> client.", ['@name' => $factory->getClientName()]),
      'severity'    => DeprecationHelper::backwardsCompatibleCall(\Drupal::VERSION, '11.2.0', fn() => RequirementSeverity::OK, fn() => REQUIREMENT_OK),
    ];
  }
  else {
    $requirements['redis'] = [
      'title'       => "Redis",
      'value'       => t("Not connected."),
      'severity'    => DeprecationHelper::backwardsCompatibleCall(\Drupal::VERSION, '11.2.0', fn() => RequirementSeverity::Warning, fn() => REQUIREMENT_WARNING),
      'description' => t("No Redis client connected, this module is therefore not used. Ensure that Redis is configured correctly, or disable this module."),
    ];
  }

  return $requirements;
}
